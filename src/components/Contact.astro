---
import Icon from './Icon.astro';
import ConsultationForm from './ConsultationForm';
import { firm } from '../data/site';

const details = [
  {
    icon: 'map-pin',
    label: 'Office Location',
    lines: [firm.address.street, `${firm.address.city}, ${firm.address.state} ${firm.address.zip}`],
    href: 'https://maps.google.com/?q=300+Montgomery+Street+Suite+850+San+Francisco+CA+94104',
  },
  {
    icon: 'phone',
    label: 'Direct Line & Detention Intake',
    lines: [firm.phoneDisplay],
    href: firm.phoneHref,
  },
  {
    icon: 'mail',
    label: 'Email Address',
    lines: [firm.email],
    href: firm.emailHref,
  },
  {
    icon: 'clock',
    label: 'Hours of Operation',
    lines: [firm.hours, firm.hoursNote],
    href: null,
  },
];
---

<section id="contact" class="relative overflow-hidden border-t-4 border-brand-800 bg-stone-900 py-16 text-white sm:py-24">
  <div
    class="pointer-events-none absolute -top-32 right-0 size-[30rem] rounded-full bg-brand-800/15 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="shell relative">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <span class="eyebrow-light">Get In Touch</span>
        <h2 class="mt-2.5 text-[1.9rem] leading-[1.12] font-semibold text-white sm:text-[2.35rem]">
          Contact Sulfab Law Office
        </h2>
        <span class="mt-4 block h-0.5 w-16 bg-brand-500" aria-hidden="true"></span>

        <p class="mt-5 max-w-md text-[13.5px] leading-relaxed font-light text-stone-300">
          If you need an immigration lawyer in San Francisco or elsewhere in California, start with
          a free consultation. Tell us what is happening and we will explain your options.
        </p>

        <div class="mt-7 space-y-4">
          {
            details.map((item) => (
              <div class="flex items-start gap-3">
                <span class="flex size-9 shrink-0 items-center justify-center border border-brand-700 bg-stone-800 text-brand-300">
                  <Icon name={item.icon} class="size-4" />
                </span>
                <div class="min-w-0 text-[12px] leading-relaxed text-stone-200">
                  <span class="block font-serif text-[12.5px] font-semibold text-white">{item.label}</span>
                  {item.lines.map((line, index) => (
                    item.href && index === 0 ? (
                      <a
                        href={item.href}
                        target={item.href.startsWith('http') ? '_blank' : undefined}
                        rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                        class="break-words text-stone-200 underline decoration-brand-700 underline-offset-4 transition hover:text-brand-200"
                      >
                        {line}
                      </a>
                    ) : (
                      <span class="block text-stone-300">{line}</span>
                    )
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="border-x border-b border-stone-200 border-t-4 border-t-brand-800 bg-white p-6 text-slate-800 shadow-2xl sm:p-8" data-reveal>
          <div class="mb-5 border-b border-stone-200 pb-3">
            <h3 class="text-xl font-semibold text-slate-900">Schedule a Free Consultation</h3>
            <p class="mt-1 text-[11px] text-slate-500">
              Tell us what is happening. We will review the facts and respond within one business
              day.
            </p>
          </div>
          <ConsultationForm client:load variant="full" idPrefix="contact" />
        </div>
      </div>
    </div>
  </div>
</section>
