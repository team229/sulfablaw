---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { practiceAreas } from '../data/site';
---

<section id="practices" class="border-b border-stone-200 bg-stone-100 py-16 sm:py-24">
  <div class="shell">
    <SectionHeading
      eyebrow="Practice Areas"
      title="Immigration Practice Areas"
      description="Each practice area below links to its own page. Here is what we handle and when people usually call."
    />

    <div class="mt-11 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        practiceAreas.map((area, index) => (
          <article class="group relative flex flex-col border border-stone-200 bg-white p-6 transition duration-300 hover:-translate-y-0.5 hover:border-brand-800 hover:shadow-float">
            <div class="flex items-start justify-between">
              <span class="flex size-12 items-center justify-center border border-brand-200 bg-brand-50 text-brand-800 transition duration-300 group-hover:border-brand-800 group-hover:bg-brand-800 group-hover:text-white">
                <Icon name={area.icon} class="size-5" />
              </span>
              <span class="font-mono text-[10px] text-stone-400">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <h3 class="mt-5 text-lg leading-snug font-semibold transition-colors group-hover:text-brand-800">
              {area.title}
            </h3>
            <p class="mt-2.5 text-[12.5px] leading-relaxed text-slate-600">
              {area.body}
            </p>

            <div class="mt-5 border-t border-stone-100 pt-4">
              <a href={area.href} class="link-arrow">
                {area.cta}
                <Icon name="arrow-right" class="size-3.5" />
              </a>
            </div>
          </article>
        ))
      }

      <article
        class="group relative flex flex-col justify-between gap-6 border border-stone-200 bg-white p-6 transition duration-300 hover:border-brand-800 hover:shadow-float md:col-span-2 lg:col-span-3 md:flex-row md:items-center md:p-8"
      >
        <div class="max-w-4xl">
          <div class="flex items-center gap-4">
            <span class="flex size-12 shrink-0 items-center justify-center border border-brand-200 bg-brand-50 text-brand-800 transition group-hover:border-brand-800 group-hover:bg-brand-800 group-hover:text-white">
              <Icon name="briefcase" class="size-5" />
            </span>
            <div>
              <span class="font-mono text-[10px] tracking-wide text-stone-400 uppercase">Beyond immigration</span>
              <h3 class="text-lg leading-snug font-semibold transition-colors group-hover:text-brand-800">
                Other Legal Services
              </h3>
            </div>
          </div>
          <p class="mt-3 text-[12.5px] leading-relaxed text-slate-600">
            Maisoun also practices personal injury and intellectual property law, and is admitted
            to practice before the U.S. Patent and Trademark Office.
          </p>
        </div>
        <a href="/contact-us" class="btn-primary shrink-0 self-start md:self-center">
          Discuss Other Matters
        </a>
      </article>
    </div>
  </div>
</section>
