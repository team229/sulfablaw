---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { differentiators } from '../data/site';
---

<section id="why" class="bg-white py-16 sm:py-24">
  <div class="shell">
    <SectionHeading
      eyebrow="Our Distinct Philosophy"
      title="Why Clients Choose Sulfab Law Office"
    />

    <div class="mt-11 grid grid-cols-1 gap-5 md:grid-cols-2">
      {
        differentiators.map((item) => (
          <article
            class="group border border-stone-200 bg-stone-50 p-6 shadow-card transition duration-300 hover:border-brand-800 hover:bg-white hover:shadow-float sm:p-8"
            data-reveal
          >
            <div class="flex items-center gap-3.5">
              <span class="flex size-10 shrink-0 items-center justify-center border border-brand-200 bg-white text-brand-800 shadow-sm transition group-hover:bg-brand-800 group-hover:text-white">
                <Icon name={item.icon} class="size-[18px]" />
              </span>
              <h3 class="text-lg leading-snug font-semibold sm:text-xl">{item.title}</h3>
            </div>
            <p class="mt-3.5 text-[13px] leading-relaxed font-light text-slate-600">
              {item.body}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
