---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { processSteps } from '../data/site';
---

<section id="process" class="border-b border-stone-200 bg-stone-100 py-16 sm:py-24">
  <div class="shell">
    <SectionHeading
      eyebrow="A Clear, Transparent Process"
      title="How Your Case Works"
    />

    <ol class="mt-11 grid grid-cols-1 gap-4 md:grid-cols-5" data-reveal>
      {
        processSteps.map((step, index) => (
          <li class="group relative flex flex-col border border-stone-200 border-t-2 border-t-brand-800 bg-white p-5 shadow-card transition duration-300 hover:shadow-float">
            <div class="flex items-baseline justify-between">
              <span class="font-serif text-[1.7rem] leading-none font-semibold text-brand-800">
                {String(index + 1).padStart(2, '0')}
              </span>
              {index < processSteps.length - 1 && (
                <Icon
                  name="arrow-right"
                  class="size-4 text-stone-300 transition group-hover:text-brand-400"
                />
              )}
            </div>
            <h3 class="mt-3.5 text-[13.5px] leading-snug font-semibold text-slate-900 sm:text-sm">
              {step.title}
            </h3>
            <p class="mt-2 text-[11.5px] leading-relaxed text-slate-600">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex flex-col items-center gap-4">
      <a href="#contact" class="btn-primary">
        Schedule a Free Consultation
      </a>
    </div>
  </div>
</section>
