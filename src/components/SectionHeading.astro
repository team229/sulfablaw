---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'center' | 'left';
  tone?: 'dark' | 'light';
  rule?: boolean;
}

const {
  eyebrow,
  title,
  description,
  align = 'center',
  tone = 'dark',
  rule = true,
} = Astro.props;

const centered = align === 'center';
const light = tone === 'light';
---

<div class:list={['max-w-3xl', centered && 'mx-auto text-center']}>
  <span class={light ? 'eyebrow-light' : 'eyebrow'}>{eyebrow}</span>
  <h2
    class:list={[
      'mt-2.5 text-[1.9rem] leading-[1.12] font-semibold tracking-[-0.01em] sm:text-[2.35rem] lg:text-[2.6rem]',
      light ? 'text-white' : 'text-slate-900',
    ]}
  >
    {title}
  </h2>
  {rule && (
    <span
      class:list={[
        'mt-4 block h-0.5 w-16',
        centered && 'mx-auto',
        light ? 'bg-brand-400' : 'bg-brand-800',
      ]}
      aria-hidden="true"
    />
  )}
  {description && (
    <p
      class:list={[
        'mt-4 text-[13px] leading-relaxed sm:text-sm',
        light ? 'text-stone-300' : 'text-slate-600',
      ]}
    >
      {description}
    </p>
  )}
</div>
