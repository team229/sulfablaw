---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { profileLinks } from '../data/site';

const yelp = profileLinks.find((profile) => profile.label === 'Yelp')!;

const reviews = [
  {
    quote:
      'If you are searching for a good immigration attorney, stop your search now and hire May today! She’s the BEST.',
    name: 'Chang L.',
    date: 'February 28, 2022',
  },
  {
    quote:
      'Very helpful and gave great guidance regarding my immigration related question. Would definitely consider them for future consultations.',
    name: 'Sharon P.',
    date: 'June 4, 2019',
  },
  {
    quote:
      'Highly recommend May. It took awhile to find the right attorney as I felt a lot of attorneys in Bay Area hesitated to share openly…',
    name: 'Regina P.',
    date: 'December 23, 2021',
  },
];

const guides = [
  {
    category: 'Detention & Habeas',
    title: 'Challenging Unlawful ICE Detention',
    body: 'How bond hearings and federal habeas corpus petitions work when a family member is held in ICE custody.',
    href: '/immigration-law-service/immigration-detention-lawyer',
    cta: 'Read the detention guide',
  },
  {
    category: 'Asylum',
    title: 'Building an Asylum Case That Holds Up',
    body: 'Evidence, the one-year deadline, and the preparation that makes a credible, consistent claim.',
    href: '/immigration-law-service/asylum-lawyer',
    cta: 'Read the asylum guide',
  },
  {
    category: 'Federal Litigation',
    title: 'When Federal Court Is the Right Forum',
    body: 'Mandamus, APA lawsuits and habeas petitions for agency delay, unlawful denials and detention.',
    href: '/immigration-law-service/federal-immigration-litigation',
    cta: 'Read the federal guide',
  },
];
---

<section id="testimonials" class="relative overflow-hidden bg-brand-950 py-16 text-white sm:py-24">
  <div class="pointer-events-none absolute -top-40 -right-40 size-[28rem] rounded-full bg-brand-700/20 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-0 -left-40 size-[24rem] rounded-full bg-brand-800/20 blur-3xl" aria-hidden="true"></div>

  <div class="shell relative">
    <SectionHeading
      eyebrow="Client Experiences"
      title="Client Reviews and Testimonials"
      tone="light"
    />

    <p class="mx-auto mt-5 max-w-2xl text-center text-[12px] leading-relaxed text-stone-300">
      Rated 4.0 out of 5 across 7 Yelp reviews. These are excerpts from public reviews; read the full
      reviews on the firm’s Yelp profile.
    </p>

    <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        reviews.map((review) => (
          <figure class="flex h-full flex-col justify-between border border-brand-800 bg-brand-900 p-6 shadow-xl">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-serif text-4xl leading-none text-brand-400" aria-hidden="true">“</span>
                <span class="font-mono text-[9px] tracking-[0.1em] text-stone-400 uppercase">Yelp review</span>
              </div>
              <blockquote class="mt-4">
                <p class="font-serif text-[15px] leading-relaxed text-stone-100 italic">
                  “{review.quote}”
                </p>
              </blockquote>
            </div>
            <figcaption class="mt-5 border-t border-brand-800 pt-4">
              <span class="block text-[12px] font-semibold text-white">{review.name}</span>
              <span class="mt-0.5 block text-[10px] text-stone-400">{review.date}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
      <a
        href={yelp.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-brand-700 bg-brand-900 px-4 py-2.5 text-[10.5px] font-semibold tracking-[0.08em] text-stone-100 uppercase transition hover:border-brand-500 hover:text-white"
      >
        Read all 7 reviews on Yelp
        <Icon name="external" class="size-3.5 text-brand-300" />
      </a>
      <span class="text-[10px] text-stone-400">
        Reviews are published as written by clients. Past results do not guarantee a similar outcome.
      </span>
    </div>

    <div class="pt-14">
      <div class="mx-auto mb-9 max-w-3xl text-center">
        <span class="eyebrow-light">Practice Guides</span>
        <h2 class="mt-2 text-2xl font-semibold text-white sm:text-[1.75rem]">
          Understand Your Options
        </h2>
        <span class="mx-auto mt-3 block h-0.5 w-16 bg-brand-400" aria-hidden="true"></span>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
        {
          guides.map((guide) => (
            <article class="flex flex-col justify-between border border-brand-800 bg-brand-900 p-5 transition duration-300 hover:border-brand-500 hover:bg-brand-900/80">
              <div>
                <span class="inline-block bg-brand-950 px-2 py-0.5 font-mono text-[9px] tracking-[0.08em] text-stone-300 uppercase">
                  {guide.category}
                </span>
                <h3 class="mt-3 text-[15px] leading-snug font-semibold text-white">
                  {guide.title}
                </h3>
                <p class="mt-2 text-[11.5px] leading-relaxed text-stone-300">
                  {guide.body}
                </p>
              </div>
              <div class="mt-4 border-t border-brand-800 pt-3 text-right">
                <a
                  href={guide.href}
                  class="inline-flex items-center gap-1.5 text-[10.5px] font-semibold tracking-[0.06em] text-stone-200 transition hover:text-white"
                >
                  {guide.cta}
                  <Icon name="arrow-right" class="size-3" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
