---
import FaqAccordion from './FaqAccordion';
import SectionHeading from './SectionHeading.astro';
import { faqs, firm } from '../data/site';
---

<section id="faq" class="border-b border-stone-200 bg-stone-50 py-16 sm:py-24">
  <div class="shell">
    <div class="mx-auto max-w-4xl">
      <SectionHeading
        eyebrow="Answers & Clarity"
        title="Frequently Asked Questions"
        align="center"
      />

      <div class="mt-10" data-reveal>
        <FaqAccordion client:visible items={faqs} defaultOpen={0} />
      </div>

      <p class="mt-8 text-center text-[12px] text-slate-600">
        Still have a question about your situation?{' '}
        <a
          href={firm.phoneHref}
          class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 transition hover:text-brand-950"
        >
          Call {firm.phoneDisplay}
        </a>{' '}
        or{' '}
        <a
          href="#contact"
          class="font-semibold text-brand-800 underline decoration-brand-300 underline-offset-4 transition hover:text-brand-950"
        >
          request a free consultation
        </a>.
      </p>
    </div>
  </div>
</section>
