---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | Sulfab Law Office"
  description="Contact Sulfab Law Office in San Francisco for immigration, intellectual property, personal injury, and workers' compensation legal help."
>
  <section class="hero contact-hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-gold-bar"></div>
        <span class="hero-page-label">Sulfab Law Office</span>
        <h1 class="hero-page-title">Contact Us</h1>
        <p class="hero-page-subtitle">Visit our Financial District office, call us, or request a confidential case review. We serve clients throughout the Bay Area and nationwide.</p>
      </div>
    </div>
  </section>

  <section class="contact-main">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-info">
          <div class="contact-info-block">
            <p class="kicker">Headquarters</p>
            <h2 class="contact-heading">San Francisco Office</h2>
            <address class="contact-address">
              <p class="contact-address-line">
                <svg class="lucide contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>369 Pine St, Suite 600<br />San Francisco, CA 94104</span>
              </p>
            </address>
            <a href="https://www.google.com/maps/dir/?api=1&destination=369+Pine+St,+Suite+600,+San+Francisco,+CA+94104" target="_blank" rel="noopener noreferrer" class="directions-link">
              Get directions
              <svg class="lucide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
            </a>
          </div>

          <div class="contact-details-card">
            <div class="contact-detail">
              <span class="contact-detail-icon">
                <svg class="lucide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <span>
                <span class="contact-detail-label">Phone</span>
                <a href="tel:+14153605266" class="contact-detail-value">(415) 360-5266</a>
              </span>
            </div>
            <div class="contact-detail">
              <span class="contact-detail-icon">
                <svg class="lucide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </span>
              <span>
                <span class="contact-detail-label">Email</span>
                <a href="mailto:sulfab@sulfablaw.com" class="contact-detail-value">sulfab@sulfablaw.com</a>
              </span>
            </div>
            <div class="contact-detail">
              <span class="contact-detail-icon">
                <svg class="lucide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </span>
              <span>
                <span class="contact-detail-label">Hours</span>
                <span class="contact-detail-text">Monday - Friday: 9:00 AM - 5:00 PM</span>
              </span>
            </div>
          </div>

          <div class="contact-cta-card">
            <p class="contact-cta-label">Case Review</p>
            <p class="contact-cta-text">Ready to discuss your matter? Submit a confidential inquiry from our homepage.</p>
            <a href="/#contact" class="btn-primary">Request Case Review</a>
          </div>
        </div>

        <div class="contact-map-col">
          <p class="kicker">Location</p>
          <div class="contact-map-container">
            <iframe
              title="Map: 369 Pine St, Suite 600, San Francisco, CA 94104"
              src="https://maps.google.com/maps?q=369%20Pine%20St%2C%20Suite%20600%2C%20San%20Francisco%2C%20CA%2094104&hl=en&z=16&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
          <p class="contact-map-note">Map shows the approximate location of our office in the Financial District. For suite access and building entry, call ahead if needed.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-glow"></div>
        <div class="cta-content">
          <div class="cta-text">
            <h2>Ready to Discuss Your Case?</h2>
            <p>Contact us today for a confidential consultation.</p>
          </div>
          <div class="cta-actions">
            <a href="/#contact" class="btn-cta">Request Case Review</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

