---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.tsx';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import About from '../components/About.astro';
import PracticeAreas from '../components/PracticeAreas.astro';
import Results from '../components/Results.astro';
import Attorney from '../components/Attorney.astro';
import WhyChoose from '../components/WhyChoose.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import Locations from '../components/Locations.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Understanding from '../components/Understanding.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.tsx';
---

<BaseLayout
  title="Immigration Lawyer San Francisco | Sulfab Law Office"
  description="Immigration attorney Maisoun Sulfab handles asylum, removal defense, detention and federal habeas cases across San Francisco and the Bay Area. Book a free consultation."
  bottomBar
>
  <SiteHeader client:load path={Astro.url.pathname} />

  <main id="main">
    <Hero />
    <TrustStrip />
    <About />
    <PracticeAreas />
    <Results />
    <Attorney />
    <WhyChoose />
    <Process />
    <Testimonials />
    <Locations />
    <Faq />
    <Contact />
    <Understanding />
  </main>

  <Footer />
  <MobileCallBar client:idle />
</BaseLayout>
