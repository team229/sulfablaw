import LegalLayout from '../components/LegalLayout.astro';
import { firm } from '../data/site';

const toc = [
  { text: 'Before your first consultation', slug: 'before-your-first-consultation' },
  { text: 'Removal proceedings in immigration court', slug: 'removal-proceedings' },
  { text: 'Asylum applications', slug: 'asylum-applications' },
  { text: 'Family-based green cards and waivers', slug: 'family-green-cards' },
  { text: 'Naturalization (Form N-400)', slug: 'naturalization' },
  { text: 'Detention, bond hearings, and habeas', slug: 'detention-and-bond' },
